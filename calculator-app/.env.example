# calculator-app environment (copy to .env.local for local development).
# NEXT_PUBLIC_* values are inlined at build time; next.config.ts maps the
# API and sign-in ones onto import.meta.env.VITE_* for the shared app code,
# so the VITE_* spellings work here too.

# --- PolicyEngine API --------------------------------------------------------
# Origin of the PolicyEngine API (v1 artifacts and the /v2 saved-work routes).
# Defaults to https://api.policyengine.org. Staging builds must point at the
# staging API so staging artifacts never land in production.
# NEXT_PUBLIC_API_URL=https://<policyengine-api-staging host>

# --- Accounts and sign-in (Auth0 social sign-on, v3 workspace only) ---------
# Inert unless NEXT_PUBLIC_AUTH_ENABLED=true AND all three Auth0 values are
# set; otherwise the app behaves exactly as it does without accounts
# (everything saved in localStorage). When on, the US and UK workspace saves
# everything to the PolicyEngine API: signed in as the account, signed out as
# this browser's unauthenticated user. The legacy calculator never signs in.
# NEXT_PUBLIC_AUTH_ENABLED=true
# Auth0 (custom) domain, e.g. auth.policyengine.org
# NEXT_PUBLIC_AUTH0_DOMAIN=
# Client ID of the SPA application for this environment
# NEXT_PUBLIC_AUTH0_CLIENT_ID=
# Identifier of the PolicyEngine API resource server, e.g. https://api.policyengine.org/
# NEXT_PUBLIC_AUTH0_AUDIENCE=
#
# Auth0 application settings this app relies on:
#   Allowed callback URLs: <origin>/us/callback, <origin>/uk/callback
#   Allowed logout URLs and web origins: <origin>/<country>, <origin>
#   Refresh-token rotation on; the API resource server allows offline access.

# --- Flagship shell -----------------------------------------------------------
# NEXT_PUBLIC_FLAGSHIP_SHELL=true

# --- Tracker bill feed (read-only, public anon key) --------------------------
# NEXT_PUBLIC_TRACKER_SUPABASE_URL=https://ffgngqlgfsvqartilful.supabase.co
# NEXT_PUBLIC_TRACKER_SUPABASE_ANON_KEY=<anon key>
