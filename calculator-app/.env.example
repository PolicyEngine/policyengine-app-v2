# calculator-app environment (copy to .env.local for local development, or
# run `vercel env pull`, which writes the Development values).
# NEXT_PUBLIC_* values are inlined at build time; next.config.ts maps the
# sign-in ones onto import.meta.env.VITE_* for the shared app code, so the
# VITE_* spellings work here too.

# --- PolicyEngine API --------------------------------------------------------
# The browser never calls the PolicyEngine API directly: every call goes to
# this app's own route, /api/policyengine/{API path}
# (src/app/api/policyengine/[...path]/route.ts), which forwards the
# operations the app uses. The calculator's server code, that route included,
# reads these at run time, on the server:
# - POLICYENGINE_API_URL: the API it calls. Production deployments default to
#   https://api.policyengine.org; every other deployment, local work included,
#   must name the staging service and is refused if it names production.
# - POLICYENGINE_API_AUTH0_*: the calculator's own Auth0 client, from the API's
#   own Auth0 tenant for that environment. With none set, requests go without
#   a server credential. Never give these a NEXT_PUBLIC_ name.
# POLICYENGINE_API_URL=https://<policyengine-api-staging host>
# POLICYENGINE_API_AUTH0_DOMAIN=<host of the PolicyEngine API's staging Auth0 tenant>
# POLICYENGINE_API_AUTH0_AUDIENCE=https://staging-api.policyengine.org/
# POLICYENGINE_API_AUTH0_CLIENT_ID=
# POLICYENGINE_API_AUTH0_CLIENT_SECRET=

# --- Accounts and sign-in (Auth0 social sign-on, v3 workspace only) ---------
# Inert unless NEXT_PUBLIC_AUTH_ENABLED=true AND all three Auth0 values are
# set; otherwise the app behaves exactly as it does without accounts
# (everything saved in localStorage). When on, the US and UK workspace saves
# everything to the PolicyEngine API: signed in as the account, signed out as
# this browser's unauthenticated user. The legacy calculator never signs in.
# NEXT_PUBLIC_AUTH_ENABLED=true
# Auth0 (custom) domain, e.g. auth.policyengine.org
# NEXT_PUBLIC_AUTH0_DOMAIN=
# Client ID of the SPA application for this environment
# NEXT_PUBLIC_AUTH0_CLIENT_ID=
# Identifier of the PolicyEngine API resource server, e.g. https://api.policyengine.org/
# NEXT_PUBLIC_AUTH0_AUDIENCE=
#
# Auth0 application settings this app relies on:
#   Allowed callback URLs: <origin>/us/callback, <origin>/uk/callback
#   Allowed logout URLs and web origins: <origin>/<country>, <origin>
#   Refresh-token rotation on; the API resource server allows offline access.

# --- Flagship shell -----------------------------------------------------------
# NEXT_PUBLIC_FLAGSHIP_SHELL=true

# --- Tracker bill feed (read-only, public anon key) --------------------------
# NEXT_PUBLIC_TRACKER_SUPABASE_URL=https://ffgngqlgfsvqartilful.supabase.co
# NEXT_PUBLIC_TRACKER_SUPABASE_ANON_KEY=<anon key>
