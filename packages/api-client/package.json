{
  "name": "@policyengine/api-client",
  "version": "0.1.0",
  "description": "Browser client for www.policyengine.org's dashboard API: household calculations, policies, economy comparisons and country metadata.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PolicyEngine/policyengine-app-v2.git",
    "directory": "packages/api-client"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.3",
    "yaml": "^2.8.1"
  }
}
