    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "test-all": "bun run prettier && bun run eslint && bun run typecheck && bun run vitest",
    "test": "bun run vitest",
    "test:quick": "bun run vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "chromatic": "chromatic --only-changed --build-script-name='storybook:build'"
